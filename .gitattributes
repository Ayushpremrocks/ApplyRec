# ===========================
# .gitattributes — ApplyRec
# Normalise line endings: LF in repo, OS-native on checkout
# ===========================

# Auto-detect text files and normalise to LF
* text=auto eol=lf

# Windows batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Force binary files to be treated as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.jar binary
*.class binary
