# ===========================
# Backend/.gitignore — Spring Boot / Maven / Java 17
# ===========================

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IDE — IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# IDE — VS Code
.vscode/
*.code-workspace

# IDE — Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/

# Environment / Secrets
.env
.env.local
.env.production
application-local.yml
application-local.properties

# Logs
*.log
logs/
spring.log

# OS
.DS_Store
Thumbs.db

# Compiled class files (generated inside src by some IDEs)
*.class

# Gradle (in case anyone switches)
.gradle/
build/

# NOTE: pom.xml must stay tracked.
