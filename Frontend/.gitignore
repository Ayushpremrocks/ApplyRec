# ===========================
# Frontend/.gitignore — React (Create React App)
# ===========================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
build/
dist/

# Environment files (keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.eslintcache

# Testing / Coverage
coverage/

# Vercel
.vercel/

# OS
.DS_Store
Thumbs.db

# NOTE: package-lock.json is intentionally NOT ignored — keep it tracked.
