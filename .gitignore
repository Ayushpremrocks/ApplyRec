# ===========================
# ROOT .gitignore — ApplyRec
# ===========================

# ── IDE / Editor ──────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS generated ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
# Keep .env.example tracked (it has no real secrets)
!.env.example

# ── ── FRONTEND (React / Node) ── ─────────────────────────────
Frontend/node_modules/
Frontend/build/
Frontend/dist/
Frontend/.cache/
Frontend/.parcel-cache/
Frontend/coverage/
Frontend/.vercel/

# ── ── BACKEND (Java / Maven / Spring Boot) ── ────────────────
Backend/target/
Backend/.mvn/
Backend/*.class

# ── Misc ──────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
